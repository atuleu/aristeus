# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: bt-bootloader-apploader
label: bt-bootloader-apploader
description: |
  Standalone Bootloader using the Bluetooth AppLoader OTA DFU. This implements in-place application updates using Bluetooth connection.
category: Example|Bootloader
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - Bootloader
- name: Project Difficulty
  value:
  - Advanced
package: bluetooth_le_app
quality: experimental
tag:
- hwfilter:device:device_supports_bluetooth
- companion:application
- hwfilter:device:device_series_2
