---
parameters:
- name: "build_dir"
constants:
- name: "project_name"
  value: "BLE_environmental_sensor"
steps:
- task: "convert"
  output: "artifact/{{project_name}}.s37"
  export: "application_binary"
  input: "{{build_dir}}/{{project_name}}.out"
- task: "create_gbl"
  output: "{{build_dir}}/{{project_name}}.gbl"
  app: "{{build_dir}}/{{project_name}}.out"
